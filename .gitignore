# caches et environnements locaux (non versionnés dans le dépôt source)
.venv/
.cache/
__pycache__/
*.pyc
.DS_Store

# galerie : les images téléchargées restent dans meromoonmeri/projet-pmdo
# (régénérables via galerie/collect.py) ; seuls scripts, data.json et index.html sont versionnés
galerie/img/
galerie/.tree_cache.json

# sorties lourdes : restent dans meromoonmeri/projet-pmdo
renders/**/*.png
renders/**/*.webp
renders/**/*.gif
renders/**/*.zip
renders/**/*.ora
exports/**/*.png
exports/**/*.zip

